# Store text files with LF line endings and check them out with LF on every OS, so diffs never
# show whole-file changes caused only by CRLF/LF conversions between Windows and Linux (CI).
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never convert or diff
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.gif binary
*.webp binary
*.pdf binary
*.mp4 binary
*.avi binary
*.mov binary
*.npy binary
*.npz binary
*.pt binary
*.onnx binary
